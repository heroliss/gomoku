<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PhotonSdkDirectory Condition="'$(PhotonSdkDirectory)' == '' and Exists('../../vendor/Photon/Photon3DotNet.dll')">../../vendor/Photon</PhotonSdkDirectory>
    <PhotonSdkDirectory Condition="'$(PhotonSdkDirectory)' == ''">../../legacy/v2.3/五子棋/Lib</PhotonSdkDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Photon3DotNet">
      <HintPath>$(PhotonSdkDirectory)/Photon3DotNet.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="PhotonLoadbalancingApi">
      <HintPath>$(PhotonSdkDirectory)/PhotonLoadbalancingApi.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
